# Server
PORT=8787
KOKUGO_DB=./data/kokugo.db
KOKUGO_UPLOADS=./data/uploads
# UI「せってい」で保存した値は DB に入り、ここより優先されます（空なら環境変数を使用）。

# Worksheet image → ParsedExercise: gemini (default) | ollama
KOKUGO_LLM_PROVIDER=gemini
# three_step = 2 steps: OCR then one JSON (structure + ruby). three_step_remote_ocr = remote OCR + same JSON step.
# one_shot = single vision call to JSON (some local VLMs).
KOKUGO_PARSE_STRATEGY=three_step

# Chat / parse backends (gemini | ollama). Each role can differ.
# KOKUGO_CHAT_BACKEND は後方互換用：個別の変数が空のときだけフォールバック（未設定時の既定は gemini）。
KOKUGO_CHAT_BACKEND=gemini
# まとめ生成・音声の文字おこし（Gemini のみ文字おこし可）
KOKUGO_CHAT_BACKEND_SUMMARY=
# 解答の採点
KOKUGO_CHAT_BACKEND_JUDGE=
# three_step / three_step_remote_ocr の第2段（OCR 後のふりがな付き JSON）。one_shot では使われません。
KOKUGO_RUBY_BACKEND=

# Ollama vision model (KOKUGO_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Text/JSON model for Ollama chat（要約・採点など Ollama を選んだロール）(defaults to OLLAMA_MODEL if empty)
OLLAMA_CHAT_MODEL=

# Gemini: worksheet parse when KOKUGO_LLM_PROVIDER=gemini; chat/ruby when that role is gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Submit / answer judging only (cheaper than main model). Override if Google renames the ID.
GEMINI_JUDGE_MODEL=gemini-2.5-flash-lite
# Exercise OCR/parse: MaxOutputTokens (default 65536). For gemini-2.5-flash the API output limit is 65536 — you cannot raise it via env; split scans or shorten furigana if you still hit MAX_TOKENS.
GEMINI_PARSE_MAX_OUTPUT=65536
# Max characters per log preview in parse pipeline (default 2000)
# KOKUGO_PARSE_LOG_MAX=2000

# Shown in the UI greeting
CHILD_NAME=がくせい
