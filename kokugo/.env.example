# Server
PORT=8787
KOKUGO_DB=./data/kokugo.db
KOKUGO_UPLOADS=./data/uploads
# UI「せってい」で保存した値は DB に入り、ここより優先されます（空なら環境変数を使用）。

# プリント画像 → 問題データは常に Gemini（GEMINI_MODEL）のワンショット vision で解析します。

# Chat backends (gemini | ollama). Each role can differ.
# KOKUGO_CHAT_BACKEND は後方互換用：個別の変数が空のときだけフォールバック（未設定時の既定は gemini）。
KOKUGO_CHAT_BACKEND=gemini
# まとめ生成・音声の文字おこし（Gemini のみ文字おこし可）
KOKUGO_CHAT_BACKEND_SUMMARY=
# 解答の採点
KOKUGO_CHAT_BACKEND_JUDGE=

# Ollama（まとめ・採点で ollama を選んだとき）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Text/JSON model for Ollama chat（空なら OLLAMA_MODEL）
OLLAMA_CHAT_MODEL=

# Gemini（プリント解析・要約/採点で gemini のとき）
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Submit / answer judging only (cheaper than main model). Override if Google renames the ID.
GEMINI_JUDGE_MODEL=gemini-2.5-flash-lite
# Worksheet parse: MaxOutputTokens (default 65536). Model max output may cap lower.
GEMINI_PARSE_MAX_OUTPUT=65536
# Max characters per log preview in parse pipeline (default 2000)
# KOKUGO_PARSE_LOG_MAX=2000
# Gemini: log each request (system, user text previews, image mime+bytes). Set 0 / false / no to disable.
# KOKUGO_GEMINI_LOG_REQUEST=

# Shown in the UI greeting
CHILD_NAME=がくせい
