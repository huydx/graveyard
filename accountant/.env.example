# Google Sheet (from the URL …/spreadsheets/d/<THIS_ID>/…)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab + columns to read/append (must match Apps Script layout)
GOOGLE_SHEETS_RANGE=

# OAuth Desktop client JSON (top-level key "installed") OR service account key ("type": "service_account")
# GOOGLE_CREDENTIALS_PATH=/absolute/path/to/client_secret.json
# GOOGLE_TOKEN_PATH=/absolute/path/to/token.json

# Same Gemini key as in Code.gs — use AI Studio, never commit the real value.
GEMINI_API_KEY=

# Optional IANA zone for the Date column (default: machine local timezone)
# ACCOUNTANT_TZ=Asia/Tokyo

# Hostname clients use in the browser (e.g. http://mybox via MagicDNS). Adds CORS for
# http://HOST, http://HOST:8765, :5173, :4173
# ACCOUNTANT_PUBLIC_HOST=mybox
